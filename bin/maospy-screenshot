#!/usr/bin/env bash
dir="$HOME/Imágenes/Capturas"
mkdir -p "$dir"
file="$dir/captura_$(date +%Y-%m-%d_%H-%M-%S).png"
case "$1" in
    area) grim -g "$(slurp)" "$file" || exit 1 ;;
    *)    grim "$file" ;;
esac
wl-copy < "$file"
notify-send -i "$file" "Captura guardada" "También quedó copiada al portapapeles"
