{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left":   ["custom/launcher", "ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right":  ["tray", "pulseaudio", "bluetooth", "network", "cpu", "memory", "custom/notification", "custom/power"],

    "custom/power": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "~/.local/bin/maospy-power"
    },
    "bluetooth": {
        "format": "\uf293",
        "format-off": "\uf294",
        "format-disabled": "\uf294",
        "format-connected": "\uf293 {num_connections}",
        "tooltip-format": "{controller_alias}: {status}",
        "on-click": "blueman-manager"
    },
    "custom/launcher": {
        "format": "\uf303",
        "tooltip": false,
        "on-click": "fuzzel"
    },
    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    "clock": {
        "format": "\uf017  {:L%a %d %b   %H:%M}",
        "locale": "es_PY.utf8",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": { "spacing": 8 },
    "pulseaudio": {
        "format": "{icon}",
        "tooltip-format": "Volumen: {volume}%",
        "format-muted": "\uf026  mudo",
        "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "network": {
        "format-ethernet": "\uf0e8  {ipaddr}",
        "format-wifi": "\uf1eb  {essid}",
        "format-disconnected": "\uf127  sin red",
        "tooltip-format": "{ifname}: {ipaddr}"
    },
    "cpu":    { "format": "\uf2db  {usage}%", "interval": 3 },
    "memory": { "format": "\uf1c0  {percentage}%", "interval": 5 },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf0f3", "none": "\uf0a2",
            "dnd-notification": "\uf1f6", "dnd-none": "\uf1f6"
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "escape": true
    }
}
